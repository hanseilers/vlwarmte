# Copy to: secrets/google-site-verification.env (gitignored via secrets/*.env)
# Google Search Console → Property → Instellingen → Ownership verification → HTML-tag
# Plak alleen de waarde uit content="…" (zonder aanhalingstekens in de env-regel).
#
#   cp secrets/google-site-verification.env.example secrets/google-site-verification.env
#   # edit secrets/google-site-verification.env
#
# Daarna in de repo-root:
#   .venv/bin/python scripts/inject_site_verification.py
# Of in één regel:
#   GOOGLE_SITE_VERIFICATION=jouw_token .venv/bin/python scripts/inject_site_verification.py
#
GOOGLE_SITE_VERIFICATION=paste_token_here
