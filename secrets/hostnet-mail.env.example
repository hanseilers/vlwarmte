# Hostnet mailbox — copy to secrets/hostnet-mail.env and fill in.
# secrets/*.env is gitignored — never commit real passwords.
#
# Incoming: imap.hostnet.nl:993 SSL/TLS
# Outgoing: smtp.hostnet.nl:587 STARTTLS (same login as IMAP unless overridden)
#
# Website-only sending sometimes uses mailout.hostnet.nl — see Hostnet docs.
#
# cp secrets/hostnet-mail.env.example secrets/hostnet-mail.env

IMAP_HOST=imap.hostnet.nl
IMAP_PORT=993
IMAP_USER=info@vlwarmte.nl
IMAP_PASSWORD=

SMTP_HOST=smtp.hostnet.nl
SMTP_PORT=587
# Optional — default to IMAP_USER / IMAP_PASSWORD
# SMTP_USER=
# SMTP_PASSWORD=

# From header for `send` (defaults to IMAP_USER)
# MAIL_FROM=info@vlwarmte.nl

# Default folder for read/move/copy when --from-mailbox omitted
# IMAP_MAILBOX=INBOX

# ── E2E (scripts/e2e_formspree_inbox.py) / GitHub Actions ──
# Standaard vult Playwright het echte formulier op productie (geen hand-POST).
# pip install -r scripts/requirements-e2e.txt && python -m playwright install chromium
# Optioneel alleen voor --http-post: Formspree-URL overschrijven
# E2E_FORMSPREE_URL=https://formspree.io/f/xxxxxxxx
# E2E_BASE_URL=https://www.vlwarmte.nl
# E-mail in testformulieren (default in script: jceilers@icloud.com)
# E2E_CUSTOMER_EMAIL=jceilers@icloud.com
# E2E_INBOX_TIMEOUT_SEC=240
# E2E_SKIP=1
# inbox_auto_thankyou.py: ook bedankmail op VLW-E2E-testsubmissions (1/true)
# INCLUDE_E2E_THANKYOU=1
# e2e_formspree_inbox.py: na testmail ook bedankmail-keten (1/true)
# E2E_WITH_THANKYOU=1
