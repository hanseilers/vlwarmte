# Google Ads API — lokaal (gitignored als `secrets/google-ads.env`)
#
# ═══════════════════════════════════════════════════════════════════════════
# SNELSTART (zelfde service account als Google Analytics)
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Zorg dat je GA-key al werkt: `secrets/vlwarmte-ga-service-account.json`
#    (of dezelfde file als `GOOGLE_APPLICATION_CREDENTIALS` / `GA4_CREDENTIALS_PATH`).
# 2. Nodig in Google Ads het *e-mailadres* van die service account uit onder
#    Admin → Toegang en beveiliging → Gebruikers.
# 3. Kopieer dit bestand:  cp secrets/google-ads.env.example secrets/google-ads.env
# 4. Vul alleen hieronder je developer token in (Google Ads → Tools → API Center).
#
# Je hoeft GEEN apart JSON-pad te zetten: scripts hergebruiken automatisch dezelfde
# key als `scripts/ga4_fetch.py`, tenzij je hieronder expliciet iets anders wilt.
#
# Test:  python scripts/google_ads_smoke_test.py
#
# ═══════════════════════════════════════════════════════════════════════════
# Optioneel — JSON overschrijven (alleen nodig als je een ander key-bestand wilt)
# ═══════════════════════════════════════════════════════════════════════════
# GOOGLE_ADS_JSON_KEY_FILE_PATH=secrets/vlwarmte-ga-service-account.json
#
# ═══════════════════════════════════════════════════════════════════════════
# Alternatief — OAuth (Desktop-app in GCP), geen service account in Ads
# ═══════════════════════════════════════════════════════════════════════════
# Zet dan WEL client id/secret en haal refresh token via:
#   python scripts/google_ads_get_refresh_token.py
# (Laat in dat geval GEEN GOOGLE_ADS_JSON_KEY_FILE_PATH staan tenzij je weet
#  wat je doet; anders liever alleen OAuth-variabelen vullen.)

GOOGLE_ADS_DEVELOPER_TOKEN=

# Vereist door recente google-ads Python-client (default in scripts; optioneel hier)
# GOOGLE_ADS_USE_PROTO_PLUS=True

# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=

# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optioneel: prefix voor API-aangemaakte campagnes (default VLW-API-)
# GOOGLE_ADS_CAMPAIGN_PREFIX=VLW-API-
